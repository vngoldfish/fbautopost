# ==============================================================================
# FB Auto Post Production Environment Configuration (.env)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=19823

# Security & Authentication
# Change SYNC_TOKEN to a secure random string for production deployment
SYNC_TOKEN=fbauto_secret_token_prod_2026
PROJECT_KEY_DEFAULT=all

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POLL_PER_MIN=60
RATE_LIMIT_CREATION_PER_MIN=120
RATE_LIMIT_GENERAL_PER_MIN=300

# Docker Resource Constraints
DOCKER_MEM_LIMIT=1024M
DOCKER_CPU_LIMIT=2.0
